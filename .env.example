OLLAMA_BASE_URL=http://127.0.0.1:11434
# Model selection lives in config.toml (model = "qwen2.5" | "qwen3.5").
NUM_CTX=2048
THINKING_ENABLED=true
AUTO_FIX=true
AUTO_FIX_MAX=1
AUTO_SKIP=true
AUTO_REPLAN=true
# Install a missing language toolchain (g++, make, cargo, …) via apt-get
AUTO_INSTALL=true
WORKSPACE_DIR=workspace
# Memory caps for a low-RAM host. Ollama's own defaults are "auto", which on a
# CPU-only box means several resident copies of the model and several parallel
# KV caches; NUM_CTX bounds one slot, not the total.
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_QUEUE=1
# Keep the one resident copy warm between graph nodes; 0 unloads after every
# call, which costs a full model reload per node on a CPU-only host.
OLLAMA_KEEP_ALIVE=5m
OLLAMA_MEM_LIMIT=5g
APP_MEM_LIMIT=1g
EXEC_TIMEOUT_SEC=60
HOST=0.0.0.0
PORT=8000
